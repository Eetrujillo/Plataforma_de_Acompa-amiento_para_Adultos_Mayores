# Copia este archivo como .env en la raíz del proyecto y ajusta los valores.
# El archivo .env no debe subirse al repositorio.

MONGO_URL=mongodb://mongo:27017/mearn_db
BACKEND_PORT=3505

# Usa un secreto largo, aleatorio y distinto en cada entorno.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Déjalo vacío para permitir cualquier origen en desarrollo.
# En producción, usa el dominio real, por ejemplo:
# CORS_ORIGIN=https://gestion-academica.apolobyte.top
CORS_ORIGIN=

# URL pública del frontend. Se usa para armar el enlace de confirmación.
# En producción debe ser el dominio real, por ejemplo:
# APP_URL=https://gestion-academica.apolobyte.top
APP_URL=http://localhost:3201

# Servidor SMTP para enviar los correos de confirmación.
# Sin SMTP_HOST, en desarrollo el enlace se imprime en la consola del backend.
# En producción es obligatorio configurarlo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plataforma de Acompañamiento <no-reply@example.com>"

# Prefijo del contenido del QR de vinculación (HU-006).
LINK_QR_BASE_URL=acompanamiento://vincular
