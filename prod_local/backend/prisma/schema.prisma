generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Cuenta de familiar (CAREGIVER) o de adulto mayor (SENIOR).
/// MongoDB no tiene enums nativos: `role` es un String validado.
model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String?
  fullName     String
  role         String
  phone        String?
  caregiverId  String?  @db.ObjectId
  emailVerifiedAt DateTime?
  /// HU-003 lockout state.
  failedLoginAttempts Int?
  lockedUntil         DateTime?
  /// Ley 1581 consent evidence.
  acceptedTermsAt DateTime?
  termsVersion    String?
  ipAddress       String?

  /// HU-005 / HU-011: perfil del adulto mayor.
  /// El PIN se guarda como hash bcrypt y solo se usa para cerrar la sesión de la app.
  pinHash String?
  timeZone String?
  linkStatus String?
  /// HU-008: consentimiento del adulto mayor sobre el texto vigente.
  consentVersion    String?
  consentAcceptedAt DateTime?
  /// HU-009/HU-010/HU-011: se incrementa para invalidar los tokens ya emitidos.
  sessionVersion Int      @default(0)
  /// HU-011: intentos fallidos del PIN y su bloqueo temporal.
  failedPinAttempts Int?
  pinLockedUntil    DateTime?
  deletedAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([caregiverId])
}

/// Token de un solo uso que prueba que la cuenta controla el correo.
/// Solo se guarda el SHA-256 del token.
model EmailVerificationToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// HU-004: enlace de recuperación de contraseña. Igual que la verificación,
/// solo se guarda el hash del token.
model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// HU-006: código de vinculación del dispositivo del adulto mayor.
/// `seniorId` se fija al generarlo si el familiar ya creó el perfil (HU-005).
model PairingCode {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  code        String    @unique
  caregiverId String    @db.ObjectId
  seniorId    String?   @db.ObjectId
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([caregiverId])
}

/// HU-012 a HU-015: actividad de la rutina.
/// `scheduledDate`/`scheduledTime` describen la primera ocurrencia en la zona
/// horaria `timeZone`; la repetición se expande al consultar.
model Activity {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  seniorId      String    @db.ObjectId
  createdBy     String    @db.ObjectId
  title         String
  description   String?
  scheduledTime String
  scheduledDate String
  status        String    @default("PENDING")
  completedAt   DateTime?

  icon       String?
  timeZone   String?
  repeatType String?   @default("once")
  weekdays   Int[]     @default([])
  active     Boolean?  @default(true)
  deletedAt  DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([seniorId, scheduledDate])
  @@index([status])
  @@index([seniorId, repeatType])
}

/// HU-018 / HU-019: marca de una ocurrencia concreta (actividad + día).
/// La hora es la del toque en el celular, no la de llegada.
model ActivityCompletion {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  activityId     String   @db.ObjectId
  seniorId       String   @db.ObjectId
  occurrenceDate String
  completedAt    DateTime
  createdAt      DateTime @default(now())

  @@unique([activityId, occurrenceDate])
  @@index([seniorId, occurrenceDate])
}

/// HU-007: intentos de canje por IP, para bloquear la fuerza bruta.
model LinkAttempt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ip        String?
  code      String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

/// Alerta de emergencia del dispositivo del adulto mayor con su posición GPS.
model SosAlert {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  seniorId   String    @db.ObjectId
  latitude   Float
  longitude  Float
  accuracy   Float?
  message    String?
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?   @db.ObjectId

  @@index([seniorId, status])
  @@index([status])
}
