# Compose environment template.
#
# Required before `docker compose up` (compose loads this file via env_file):
#   cp env.sample .env
#
# Never commit the real .env: it is gitignored on purpose.

# MONGO_URL / DATABASE_URL are pinned in docker-compose.yml on purpose:
# the stack owns a single node replica set (rs0) on host `mongo`, and Prisma needs
# ?replicaSet=rs0 to run writes. Nothing here has to set them, and a stale value
# from another project is ignored.

BACKEND_PORT=3500
BACKEND_INTERNAL_PORT=3500

NODE_ENV=production
CORS_ORIGIN=*

# Generate a real one: openssl rand -hex 32
JWT_SECRET=change-me-before-deploying
JWT_EXPIRES_IN=7d
PAIRING_TTL_MINUTES=15
# HU-006: vigencia del código que el familiar le dicta al adulto mayor.
PAIRING_PROFILE_TTL_MINUTES=1440

# Public URL that users open in the browser. The email verification link is
# built as ${APP_URL}/verify-email?token=...
APP_URL=http://localhost:3201
EMAIL_VERIFICATION_TTL_HOURS=24

# HU-002: resend limit per email inside a sliding window. The fourth attempt inside
# the window answers 429. A malformed value falls back to these defaults.
RESEND_THROTTLE_MAX=3
RESEND_THROTTLE_WINDOW_MINUTES=60

# HU-003: temporary account lock after consecutive failed logins. A malformed value
# falls back to the acceptance criterion (5 attempts, 15 minutes).
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# SMTP for the verification email. Without SMTP_HOST the link is only printed in
# the backend logs: mail delivery will not work for real users.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plataforma de Acompañamiento <no-reply@example.com>"
