# Compose environment template.
#
# Required before `docker compose up` (compose loads this file via env_file):
#   cp env.sample .env
#
# Never commit the real .env: it is gitignored on purpose.

# Inside the compose network mongo answers on its container port 27017.
# From the host it is published on 4301 (see docker-compose.yml).
DATABASE_URL=mongodb://mongo:27017/mearn_db
MONGO_URL=mongodb://mongo:27017/mearn_db

BACKEND_PORT=3500
BACKEND_INTERNAL_PORT=3500

NODE_ENV=production
CORS_ORIGIN=*

# Generate a real one: openssl rand -hex 32
JWT_SECRET=change-me-before-deploying
JWT_EXPIRES_IN=7d
PAIRING_TTL_MINUTES=15

# Public URL that users open in the browser. The email verification link is
# built as ${APP_URL}/verify-email?token=...
APP_URL=http://localhost:3201
EMAIL_VERIFICATION_TTL_HOURS=24

# SMTP for the verification email. Without SMTP_HOST the link is only printed in
# the backend logs: mail delivery will not work for real users.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plataforma de Acompañamiento <no-reply@example.com>"
