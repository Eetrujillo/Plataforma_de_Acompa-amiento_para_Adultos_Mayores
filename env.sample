# Compose environment template.
#
# Required before `docker compose up` (compose loads this file via env_file):
#   cp env.sample .env
#
# Never commit the real .env: it is gitignored on purpose.

# MONGO_URL / DATABASE_URL are pinned in docker-compose.yml on purpose:
# the stack owns a single node replica set (rs0) on host `mongo`, and Prisma needs
# ?replicaSet=rs0 to run writes. Nothing here has to set them, and a stale value
# from another project is ignored.

BACKEND_PORT=3500
BACKEND_INTERNAL_PORT=3500
# No FRONTEND_PORT: the web container was removed with the pre-proposal's move to
# two React Native APKs.

NODE_ENV=production
CORS_ORIGIN=*

# Generate a real one: openssl rand -hex 32
JWT_SECRET=change-me-before-deploying
JWT_EXPIRES_IN=7d
# Only \d+[smhd] non-zero durations are accepted (30m, 2h, 7d); anything else
# falls back to 7d (C3): a malformed value used to make every login answer 500.
# 1440 = 24 h (HU-006). El panel muestra expiresAt, no este número. El default vive en la
# constante PAIRING_TOKEN_TTL_MINUTES; esta variable lo pisa.
PAIRING_TTL_MINUTES=1440

# Public URL the clients use to build links (verification, password reset,
# caregiver invitation): ${APP_URL}/verify-email?token=...
# In production this is the domain served by the host nginx, which proxies to
# the published backend port. There is no web app container.
APP_URL=http://localhost:3500
EMAIL_VERIFICATION_TTL_HOURS=24

# Trusted proxy hops in front of the backend (0 = none). Fail closed: with 0 the
# X-Forwarded-For header of a direct client is ignored and the Ley 1581 consent
# evidence stores the socket IP. Production declares the real proxies (e.g. 2
# with Cloudflare + host nginx). Empty or malformed falls back to 0.
#
# HU-003/C1: the per-IP login limiter keys on req.ip — with 0 hops behind a
# proxy EVERY client shares a single bucket (20 failures by one person lock out
# the whole world's login for 15 minutes). In production always declare the real
# hop count: with NODE_ENV=production and 0, boot prints a loud console.warn.
TRUST_PROXY_HOPS=0

# HU-002: resend limit per email inside a sliding window. The fourth attempt inside
# the window answers 429. A malformed value falls back to these defaults.
RESEND_THROTTLE_MAX=3
RESEND_THROTTLE_WINDOW_MINUTES=60

# HU-003: temporary account lock after consecutive failed logins. A malformed value
# falls back to the acceptance criterion (5 attempts, 15 minutes).
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# HU-003: per-IP limit of failed login attempts inside a sliding window, so nobody
# can lock someone else out with their email. In-memory, per process. Requires
# trusted proxy hops properly declared (see TRUST_PROXY_HOPS, C1).
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW_MINUTES=15

# HU-004: password reset link lifetime.
PASSWORD_RESET_TTL_MINUTES=60

# SMTP for the verification email. Without SMTP_HOST the link is only printed in
# the backend logs: mail delivery will not work for real users.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plataforma de Acompañamiento <no-reply@example.com>"
