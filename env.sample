# Compose environment template.
#
# Required before `docker compose up` (compose loads this file via env_file):
#   cp env.sample .env
#
# Never commit the real .env: it is gitignored on purpose.

# Inside the compose network mongo answers on its container port 27017.
# From the host it is published on 4301 (see docker-compose.yml).
DATABASE_URL=mongodb://mongo:27017/mearn_db
MONGO_URL=mongodb://mongo:27017/mearn_db

BACKEND_PORT=3500
BACKEND_INTERNAL_PORT=3500

NODE_ENV=production
CORS_ORIGIN=*

# Generate a real one: openssl rand -hex 32
JWT_SECRET=change-me-before-deploying
JWT_EXPIRES_IN=7d
PAIRING_TTL_MINUTES=15
