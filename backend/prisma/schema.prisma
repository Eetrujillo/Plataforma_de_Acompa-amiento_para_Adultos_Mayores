generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Caregiver or senior account.
/// MongoDB has no native enums, so `role` is a validated String.
/// Canonical values used by the app (mobile-app/src/services/auth.ts):
/// `administrador` | `adulto_mayor` | `cuidador` | `familiar`.
/// Legacy values kept readable for documents created before the app existed:
/// `CAREGIVER` reads as `cuidador`, `SENIOR` reads as `adulto_mayor`.
model User {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  email               String    @unique
  passwordHash        String?
  fullName            String
  role                String
  phone               String?
  caregiverId         String?   @db.ObjectId
  emailVerifiedAt     DateTime?
  /// HU-003 lockout state. Nullable on purpose: documents created before this field
  /// existed do not carry it, and Mongo needs no data migration for that. A null value
  /// means "no failed attempts" and "not locked".
  failedLoginAttempts Int?
  lockedUntil         DateTime?
  /// HU-004 session version. Every JWT carries the version it was issued with; a
  /// password reset bumps it, which invalidates every session opened before. Nullable
  /// for the same reason as the lockout fields: documents already exist without it and
  /// a null reads as 0.
  sessionVersion      Int?
  /// HU-005 senior profile. A caregiver has no PIN and no link state, so both fields are
  /// nullable; the documents created before this field existed read as "not set" too.
  /// `pinHash` never leaves the persistence layer: the public projection excludes it.
  pinHash             String?
  timezone            String?   @default("America/Bogota")
  linkStatus          String?   @default("PENDING")
  /// Ley 1581 consent evidence: stamped by the server when the account is created.
  acceptedTermsAt     DateTime?
  termsVersion        String?
  ipAddress           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([role])
  @@index([caregiverId])
}

/// Single use token that proves the account owner controls the email address.
/// Only the SHA-256 hash of the raw token is stored.
model EmailVerificationToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Un solo uso y 60 minutos de vida. Colección propia a propósito: un enlace de
/// verificación de correo no puede servir para cambiar la contraseña (HU-004).
model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Credencial de vinculación de un adulto mayor (HU-006, rework QR-only de L9).
/// No existe un código legible: el único soporte es el QR, y en esta colección queda
/// únicamente el SHA-256 del token (`tokenHash`). Quien lea la colección no puede
/// reconstruir un QR válido.
/// El token siempre pertenece a un perfil (`seniorId` obligatorio desde L9).
/// `usedAt` significa "canjeado" y `invalidatedAt` "reemplazado por uno más nuevo": un
/// token reemplazado no fue usado, así que no se puede marcar con `usedAt` sin mentir.
/// Los dos son nullable porque la creación los escribe en null de forma explícita y porque
/// un documento sin el campo también tiene que poder reclamarse.
model PairingToken {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash     String    @unique
  caregiverId   String    @db.ObjectId
  seniorId      String    @db.ObjectId
  expiresAt     DateTime
  usedAt        DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([caregiverId])
  @@index([caregiverId, seniorId])
}

/// Daily routine item assigned by a caregiver to a senior.
model Activity {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  seniorId      String    @db.ObjectId
  createdBy     String    @db.ObjectId
  title         String
  description   String?
  scheduledTime String
  scheduledDate String
  status        String    @default("PENDING")
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([seniorId, scheduledDate])
  @@index([status])
}

/// Emergency alert raised from a senior device with its GPS position.
model SosAlert {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  seniorId   String    @db.ObjectId
  latitude   Float
  longitude  Float
  accuracy   Float?
  message    String?
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?   @db.ObjectId

  @@index([seniorId, status])
  @@index([status])
}

/// ---------------------------------------------------------------------------
/// Entidades de la aplicación de acompañamiento (mobile-app/src/modules/models.ts).
///
/// Convención intencional: los modelos preservados del equipo usan vocabulario en
/// inglés (`Activity`, `SosAlert`, `seniorId`); las entidades que nacen con la app
/// usan el vocabulario del dominio tal como lo nombra la interfaz, para que el mapeo
/// con `modules/models.ts` sea uno a uno y sin traducciones mentales.
///
/// `seniorId` es el adulto mayor destinatario del registro y `createdBy` quien lo
/// cargó: son la base del filtrado por vínculo (HU-18). La app todavía persiste local,
/// así que ningún documento existente los tiene; por eso son obligatorios solo para
/// escrituras nuevas y no se versionan datos históricos.
/// ---------------------------------------------------------------------------

/// Dosificación indicada por el médico. `horario` usa formato 24 h `HH:MM`.
model Dosificacion {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  seniorId    String   @db.ObjectId
  createdBy   String   @db.ObjectId
  medicamento String
  dosis       String
  horario     String
  notas       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([seniorId, horario])
  @@index([createdBy])
}

/// Aviso dirigido al adulto mayor y su entorno.
/// `nivel` es un String validado por la capa de aplicación, no un enum nativo:
/// los valores canónicos son `informacion` | `importante` (ASCII, sin tilde).
/// La interfaz muestra «Información»: la traducción es de presentación, no de datos.
model Alerta {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  seniorId  String   @db.ObjectId
  createdBy String   @db.ObjectId
  titulo    String
  mensaje   String
  nivel     String   @default("informacion")
  /// Fecha del aviso en formato ISO `AAAA-MM-DD`, igual que la app.
  fecha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seniorId, fecha])
  @@index([nivel])
}

/// Tarea de cuidado con seguimiento de completado.
model Tarea {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  seniorId   String   @db.ObjectId
  createdBy  String   @db.ObjectId
  titulo     String
  completada Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([seniorId, completada])
  @@index([createdBy])
}

/// Cita médica. `fecha` en `AAAA-MM-DD` y `hora` en 24 h `HH:MM`.
model Cita {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  seniorId  String   @db.ObjectId
  createdBy String   @db.ObjectId
  titulo    String
  medico    String
  lugar     String
  fecha     String
  hora      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seniorId, fecha])
  @@index([createdBy])
}

/// Vínculo entre un familiar y un adulto mayor.
/// `codigo` es el identificador que viaja en el QR: 16 caracteres hexadecimales
/// derivados del correo del familiar (mobile-app/src/services/vinculos.ts). Es único
/// para impedir que dos vínculos distintos compartan el mismo QR.
/// Un familiar puede vincularse a un adulto mayor una sola vez: `@@unique` sobre la
/// pareja evita duplicados por reintentos de escaneo.
model Vinculo {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  familiarId String   @db.ObjectId
  seniorId   String   @db.ObjectId
  codigo     String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([familiarId, seniorId])
  @@index([seniorId])
}
