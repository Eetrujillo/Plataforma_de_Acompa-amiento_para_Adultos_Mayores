# Backend runtime configuration template.
#
# Local development (backend on the host, mongo in docker):
#   cp backend/env.sample backend/.env
#
# Inside Docker Compose the root `.env` is used instead (compose env_file) and
# that file must exist before `docker compose up`.

# Mongoose reads MONGO_URL. Only needed when the backend runs on the host against
# the published port (compose publishes mongo on 4301). directConnection avoids the
# replica set discovery pointing at the `mongo` service name, which does not resolve
# here. Inside Docker these come from docker-compose.yml, not from this file.
MONGO_URL=mongodb://localhost:4301/mearn_db?directConnection=true

# Saltos de proxy confiables delante del backend (0 = ninguno). Fail closed: con
# 0 el header X-Forwarded-For de un cliente directo se ignora y la evidencia de
# consentimiento guarda la IP del socket. Producción declara sus proxies reales
# (p. ej. 2 con Cloudflare + nginx del host). Sólo dígitos entre 0 y 10; vacío,
# decimal, con prefijo numérico o fuera de rango cae a 0.
#
# HU-003/C1: el límite por IP del login usa req.ip — con 0 saltos detrás de un
# proxy TODOS los clientes comparten una sola bolsa (20 fallos de cualquier
# persona bloquean el login de todo el mundo 15 minutos). En producción declara
# siempre el número real de saltos: con NODE_ENV=production y 0, el arranque
# avisa fuerte con console.warn.
TRUST_PROXY_HOPS=0

PORT=3500
BACKEND_INTERNAL_PORT=3500
NODE_ENV=development
CORS_ORIGIN=*

# Generate a real one: openssl rand -hex 32
#
# Necesario también en desarrollo (C4): sin JWT_SECRET el backend de desarrollo
# arranca, pero el módulo auth falla al componerse (fail closed) y ni el login
# ni el registro quedan servibles. En producción, más estricto aún: sin la
# variable el proceso no arranca. Registro y login necesitan el mismo secreto.
JWT_SECRET=change-me-in-development
# JWT_EXPIRES_IN sólo acepta \d+[smhd] no nulo (duraciones tipo 30m, 2h, 7d);
# cualquier otro valor cae a 7d (C3): antes un valor malformado hacía que todo
# login respondiera 500.
JWT_EXPIRES_IN=7d
# Vigencia del QR de vinculación (HU-008), en minutos. Sólo enteros positivos;
# vacío, 0, negativo o malformado cae al default de 1440 (24 horas).
PAIRING_TTL_MINUTES=1440

# Public URL of the web app. The verification link is built from it:
# ${APP_URL}/verify-email?token=...
APP_URL=http://localhost:3500
EMAIL_VERIFICATION_TTL_HOURS=24

# HU-002: límite de reenvíos por correo dentro de una ventana móvil. El cuarto
# intento dentro de la ventana responde 429. Un valor malformado cae al default.
RESEND_THROTTLE_MAX=3
RESEND_THROTTLE_WINDOW_MINUTES=60

# HU-003: bloqueo temporal de la cuenta tras intentos fallidos consecutivos de login.
# Un valor malformado cae al criterio de aceptación (5 intentos, 15 minutos).
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# HU-003: límite de fallos de login por IP dentro de una ventana móvil, para que
# nadie bloquee a otra persona usando su correo. En memoria, por proceso. Requiere
# saltos de proxy confiables bien declarados (ver TRUST_PROXY_HOPS, C1).
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW_MINUTES=15

# HU-009: bloqueo del canje del QR tras intentos fallidos consecutivos sobre el
# mismo perfil (5 intentos, 15 minutos). El contador vive en el documento del
# adulto mayor, así que sobrevive a un reinicio.
REDEEM_MAX_ATTEMPTS=5
REDEEM_LOCKOUT_MINUTES=15

# HU-009: límite de intentos de canje por IP dentro de una ventana móvil, para que
# el canje no sirva de oráculo de tokens. En memoria, por proceso.
REDEEM_IP_MAX_ATTEMPTS=20
REDEEM_IP_WINDOW_MINUTES=15

# HU-009: ventana en la que un canje ya completado puede repetirse para recuperar
# una respuesta que no llegó (la sesión se vuelve a firmar, no se crea vínculo).
REDEEM_RECOVERY_MINUTES=15

# HU-004: vigencia del enlace de restablecimiento de contraseña.
PASSWORD_RESET_TTL_MINUTES=60

# HU-004: límite propio de forgot-password (3 por hora por correo), separado del
# de reenvío de verificación. Un valor malformado cae al default.
FORGOT_THROTTLE_MAX=3
FORGOT_THROTTLE_WINDOW_MINUTES=60

# Client ID del cliente OAuth de Google (Google Cloud -> Credentials -> OAuth
# client ID -> Web application). Es público: viaja al navegador desde
# GET /api/auth/google/config, así que no es un secreto. Sin este valor el botón
# de Google queda deshabilitado. Ver docs/google-signin.md.
GOOGLE_CLIENT_ID=

# Version of the data treatment policy stamped on every new registration
# (Ley 1581 evidence). Bump it when the policy text changes.
TERMS_VERSION=1.0

# SMTP for the verification email. Without SMTP_HOST the link is printed in the
# backend console (fine for local development, not for real users).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plataforma de Acompañamiento <no-reply@example.com>"
