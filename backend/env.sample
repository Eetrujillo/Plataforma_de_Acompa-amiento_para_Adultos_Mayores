# Backend runtime configuration template.
#
# Local development (backend on the host, mongo in docker):
#   cp backend/env.sample backend/.env
#
# Inside Docker Compose the root `.env` is used instead (compose env_file) and
# that file must exist before `docker compose up`.

# Only needed when the backend runs on the host against the published port
# (compose publishes mongo on 4301). directConnection avoids the replica set
# discovery pointing at the `mongo` service name, which does not resolve here.
# Inside Docker these values come from docker-compose.yml, not from this file.
DATABASE_URL=mongodb://localhost:4301/mearn_db?directConnection=true
MONGO_URL=mongodb://localhost:4301/mearn_db?directConnection=true

PORT=3500
BACKEND_INTERNAL_PORT=3500
NODE_ENV=development
CORS_ORIGIN=*

# Generate a real one: openssl rand -hex 32
JWT_SECRET=change-me-in-development
JWT_EXPIRES_IN=7d
PAIRING_TTL_MINUTES=15

# Public URL of the web app. The verification link is built from it:
# ${APP_URL}/verify-email?token=...
APP_URL=http://localhost:3201
EMAIL_VERIFICATION_TTL_HOURS=24

# HU-002: límite de reenvíos por correo dentro de una ventana móvil. El cuarto
# intento dentro de la ventana responde 429. Un valor malformado cae al default.
RESEND_THROTTLE_MAX=3
RESEND_THROTTLE_WINDOW_MINUTES=60

# HU-003: bloqueo temporal de la cuenta tras intentos fallidos consecutivos de login.
# Un valor malformado cae al criterio de aceptación (5 intentos, 15 minutos).
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# HU-004: vigencia del enlace de restablecimiento de contraseña.
PASSWORD_RESET_TTL_MINUTES=60

# Client ID del cliente OAuth de Google (Google Cloud -> Credentials -> OAuth
# client ID -> Web application). Es público: viaja al navegador desde
# GET /api/auth/google/config, así que no es un secreto. Sin este valor el botón
# de Google queda deshabilitado. Ver docs/google-signin.md.
GOOGLE_CLIENT_ID=

# Version of the data treatment policy stamped on every new registration
# (Ley 1581 evidence). Bump it when the policy text changes.
TERMS_VERSION=1.0

# SMTP for the verification email. Without SMTP_HOST the link is printed in the
# backend console (fine for local development, not for real users).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plataforma de Acompañamiento <no-reply@example.com>"
